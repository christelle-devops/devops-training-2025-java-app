pipeline {
	agent any

	stages {
		stage('Dummy') {
			steps {
				echo'Jenkinsfile OK - pipeline lancé'
			}
		}
		
		stage('info') {
			steps {
				echo "Job: ${env.JOB_NAME}"
				echo "Build: ${env.BUILD_NUMBER}"
			}
		}
 		stage('Lint') {
			agent {
				docker {
					image 'maven:3.8.6-openjdk-11-slim'
					
				}
			}
			steps {
				sh 'make lint'
				
			}
		}
		stage('Test') {
			agent {
				docker {
					image 'maven:3.8.6-openjdk-11-slim'
					}
				}
			steps {
				sh 'make test'
				}
			}

		}
}

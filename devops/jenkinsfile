def runInDocker(String image, Closure body) {
	docker.image(image).inside {
		body()
		}
	}



pipeline {
	agent any

	stages {
		stage('Dummy') {
			steps {
				echo'Jenkinsfile OK - pipeline lancé'
			}
		}
		
		stage('info') {
			steps {
				echo "Job: ${env.JOB_NAME}"
				echo "Build: ${env.BUILD_NUMBER}"
			}
		}
 		stage('Lint') {
			steps {
				script {
					runInDocker('maven:3.8.6-openjdk-11-slim') {
	
					sh 'make lint'
					}
				
				}
			}
		}
		stage('Test') {
			steps {
				script {
					runInDocker('maven:3.8.6-openjdk-11-slim')
					sh 'make test'
					}
				}

			}
		}
	}
}
